# Copy to .env, or better: run ./scripts/generate-env.sh meet.example.com
# and it fills in the secrets for you.

# The address people will open (no https://, no trailing slash).
SITE_ADDRESS=meet.example.com

# This machine's PUBLIC IP address. Needed by the TURN relay.
TURN_EXTERNAL_IP=203.0.113.10

# Secrets. Generate; never reuse or commit.
#   JWT_PRIVATE_KEY: openssl genpkey -algorithm ed25519   (newlines written as \n)
#   TURN_SECRET:     openssl rand -hex 32
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
TURN_SECRET=change-me
